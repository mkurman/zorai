{
  "name": "zorai",
  "private": true,
  "version": "1.0.7",
  "description": "Daemon-first agentic runtime with AI-native workflows",
  "homepage": "https://zorai.app",
  "author": {
    "name": "zorai contributors",
    "email": "noreply@zorai.app"
  },
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:electron": "npm run build && node scripts/dev-electron.cjs",
    "build": "tsc -b && vite build",
    "stage:electron": "node scripts/stage-electron-resources.cjs",
    "package:electron": "npm run build && npm run stage:electron",
    "build:electron": "npm run package:electron && electron-builder --win --linux",
    "build:electron:linux": "npm run package:electron && electron-builder --linux AppImage deb",
    "build:electron:windows": "npm run package:electron && electron-builder --win portable nsis",
    "build:electron:macos": "npm run package:electron && electron-builder --mac dmg zip",
    "preview": "vite preview",
    "lint": "eslint .",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@honcho-ai/sdk": "^2.0.1",
    "@monaco-editor/react": "4.7.0",
    "@types/js-yaml": "^4.0.9",
    "@whiskeysockets/baileys": "^6.7.21",
    "@xterm/addon-canvas": "^0.7.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.15.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "@xyflow/react": "^12.10.1",
    "buffer": "^6.0.3",
    "discord.js": "^14.25.1",
    "js-yaml": "^4.1.1",
    "katex": "^0.16.22",
    "monaco-editor": "0.52.2",
    "pino": "^9.14.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^2.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.3.6",
    "zustand": "^5.0.0",
    "prettier": "3.6.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.58.0",
    "vite": "^6.0.0",
    "vitest": "^3.2.4"
  },
  "build": {
    "appId": "app.zorai.desktop",
    "productName": "zorai",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/icon.png",
      "assets/icon.ico"
    ],
    "extraResources": [
      {
        "from": "dist/GETTING_STARTED.md",
        "to": "GETTING_STARTED.md"
      },
      {
        "from": "../guidelines",
        "to": "guidelines"
      }
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "extraResources": [
        {
          "from": "dist/zorai-daemon.exe",
          "to": "bin/zorai-daemon.exe"
        },
        {
          "from": "dist/zorai.exe",
          "to": "bin/zorai.exe"
        },
        {
          "from": "dist/zoi.exe",
          "to": "bin/zoi.exe"
        },
        {
          "from": "dist/zorai-tui.exe",
          "to": "bin/zorai-tui.exe"
        },
        {
          "from": "dist/zorai-mcp.exe",
          "to": "bin/zorai-mcp.exe"
        },
        {
          "from": "dist/zorai-gateway.exe",
          "to": "bin/zorai-gateway.exe"
        }
      ],
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "assets/icon.icns",
      "extraResources": [
        {
          "from": "dist/zorai-daemon",
          "to": "bin/zorai-daemon"
        },
        {
          "from": "dist/zorai",
          "to": "bin/zorai"
        },
        {
          "from": "dist/zoi",
          "to": "bin/zoi"
        },
        {
          "from": "dist/zorai-tui",
          "to": "bin/zorai-tui"
        },
        {
          "from": "dist/zorai-mcp",
          "to": "bin/zorai-mcp"
        },
        {
          "from": "dist/zorai-gateway",
          "to": "bin/zorai-gateway"
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/icon.png",
      "extraResources": [
        {
          "from": "dist/zorai-daemon",
          "to": "bin/zorai-daemon"
        },
        {
          "from": "dist/zorai",
          "to": "bin/zorai"
        },
        {
          "from": "dist/zoi",
          "to": "bin/zoi"
        },
        {
          "from": "dist/zorai-tui",
          "to": "bin/zorai-tui"
        },
        {
          "from": "dist/zorai-mcp",
          "to": "bin/zorai-mcp"
        },
        {
          "from": "dist/zorai-gateway",
          "to": "bin/zorai-gateway"
        }
      ]
    },
    "appImage": {
      "executableArgs": [
        "--no-sandbox"
      ]
    },
    "deb": {
      "afterInstall": "build/linux/after-install.sh",
      "afterRemove": "build/linux/after-remove.sh"
    },
    "portable": {
      "artifactName": "zorai-portable.exe"
    }
  }
}
